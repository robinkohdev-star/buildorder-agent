{
  "agent": {
    "name": "BuildOrder",
    "id": "buildorder",
    "role": "Coding agent",
    "mission": "Plans with Kimi k2.5, implements with OpenCode models on fresh branches, posts summaries to Discord"
  },
  "models": {
    "planning": {
      "provider": "opencode",
      "model": "kimi-k2.5",
      "temperature": 0.3
    },
    "implementation": {
      "provider": "opencode",
      "model": "kimi-k2.5",
      "temperature": 0.2
    }
  },
  "workflow": {
    "steps": [
      "fetch_tasks",
      "plan_with_opencode",
      "implement_with_opencode",
      "create_branch",
      "commit_changes",
      "post_summary"
    ]
  },
  "git": {
    "default_branch": "main",
    "feature_prefix": "buildorder/",
    "auto_push": false,
    "require_tests": true
  },
  "sources": {
    "task_sources": ["state/phase2-tasks.json", "memory/*.md", "github_issues"],
    "workspace_root": "~/workspace"
  },
  "schedule": {
    "cron": "0 */6 * * *",
    "timezone": "Asia/Singapore"
  },
  "output": {
    "discord_webhook": "${DISCORD_WEBHOOK_BUILD}",
    "format": "markdown"
  }
}
